# Copy to .env.local for local dev. Never commit real values.

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DAILY_BUDGET_USD=5

# Discord application
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Set for guild-scoped (instant) command registration while testing
DISCORD_DEV_GUILD_ID=

# Wizzrobe
WIZZROBE_BASE_URL=https://onsite.speedgaming.org
WIZZROBE_MCP_URL=https://wizzrobe.synack.live/mcp
WIZZROBE_AUTH_URL=https://wizzrobe.synack.live
WIZZROBE_TENANT=sgl26
COMMUNITY_TIMEZONE=America/New_York
WIZZROBE_OAUTH_CLIENT_ID=
WIZZROBE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=
# The bot's own read-only account
WIZZROBE_BOT_REFRESH_TOKEN=

# Challonge, read-only, for standings (optional: without it standings answers link out)
CHALLONGE_API_KEY=

# Encrypts users' Wizzrobe refresh tokens at rest (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# Upstash Redis (injected by the Vercel Marketplace integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
