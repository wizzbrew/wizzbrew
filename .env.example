# Copy to .env.local for local dev. Names only; real values never go in the tree.

# Anthropic: API key, and the daily spend cap in USD (positive number)
ANTHROPIC_API_KEY=
ANTHROPIC_DAILY_BUDGET_USD=

# Discord application: public key is 64 hex characters; dev guild scopes command registration
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Discord OAuth2 (identify scope) proves who is linking; redirect is https://<domain>/api/oauth/discord
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
DISCORD_DEV_GUILD_ID=
SAFE_DEFAULT_CHANNEL_ID=

# Wizzrobe: base and MCP URLs (https), tenant slug, OAuth client and redirect, the bot account
WIZZROBE_BASE_URL=
WIZZROBE_MCP_URL=
WIZZROBE_TENANT=
WIZZROBE_OAUTH_CLIENT_ID=
WIZZROBE_OAUTH_CLIENT_SECRET=
WIZZROBE_OAUTH_REDIRECT_URI=
WIZZROBE_BOT_REFRESH_TOKEN=

# Encrypts linked users' refresh tokens at rest: base64 of exactly 32 bytes
TOKEN_ENCRYPTION_KEY=

# Upstash Redis REST (injected by the Vercel Upstash integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Community clock: an IANA zone name
COMMUNITY_TIMEZONE=

# Challonge: read-only API key for standings (optional)
CHALLONGE_API_KEY=

# Relay: shared secret, at least 32 characters; staff alert channel id (optional)
RELAY_SECRET=
STAFF_ALERT_CHANNEL_ID=
